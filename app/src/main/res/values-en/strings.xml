    <string name="settings_log_axis">Logarithmic frequency axis</string>
    <string name="settings_log_axis_help">Log axis gives octaves equal space — natural for voice. Linear stretches the top.</string>
    <string name="settings_fft">Analysis window</string>
    <string name="settings_fft_help">2048 reacts faster (43 ms), 4096 is finer in frequency (85 ms). The step stays 10 ms.</string>
    <string name="settings_audio">audio</string>
    <string name="settings_source">Source</string>
    <string name="settings_source_help">UNPROCESSED — raw signal without noise suppression or auto-gain (when the device supports it). VOICE_RECOGNITION — the fallback. "Auto" picks the best available.</string>
    <string name="source_auto">auto</string>
    <string name="settings_source_status">Audio processing</string>
    <string name="settings_source_status_help">Noise suppression and auto-gain kill the ~3 kHz band this app is about. "Disabled" — the device guarantees a raw signal; "not guaranteed" — the vendor may have enabled something.</string>
    <string name="processing_disabled">disabled</string>
    <string name="processing_not_guaranteed">not guaranteed</string>
    <string name="processing_unverified">unverified</string>
    <string name="settings_feedback">feedback</string>
    <string name="settings_haptics">Vibration</string>
    <string name="settings_haptics_help">During a session the device vibrates more often the higher the score. Vibration can leak into the microphone: hold the phone or put it on something soft. Off by default on tablets.</string>
    <string name="settings_points_anim">Points animation</string>
    <string name="settings_points_anim_help">Gold dots from the cupola arc when points are awarded.</string>
    <string name="settings_hints">Hints</string>
    <string name="settings_hints_help">One line under the note: what happened to the sound. No technical instructions — only "softer", "step back" or "stop".</string>
