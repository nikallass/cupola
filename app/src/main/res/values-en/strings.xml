    <string name="settings_voice">voice</string>
    <string name="settings_voice_type">Voice type</string>
    <string name="settings_voice_type_help">Sets the cupola band — where the singer\'s formant is looked for: lower for bass, higher for soprano. Your teacher decides your voice type; here it only picks the band. You can set a custom band.</string>
    <string name="settings_band_lo">Cupola lower edge</string>
    <string name="settings_band_hi">Cupola upper edge</string>
    <string name="settings_band_help">The band where "ring" is measured. 50 Hz steps, at least 200 Hz wide. Each band has its own calibration.</string>
    <string name="settings_calibration">Calibration</string>
    <string name="settings_calibration_help">Your personal baseline: room noise, your loudness and cupola on an "ah". Stored per voice type or band. Redo it after changing device, distance or room.</string>
    <string name="settings_calibrate">Calibrate</string>
    <string name="settings_a4">A4 tuning</string>
    <string name="settings_a4_help">Frequency of A4. Standard is 440 Hz; baroque 415, "432" and so on go here.</string>
    <string name="settings_display">display</string>
