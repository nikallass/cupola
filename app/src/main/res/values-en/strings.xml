    <string name="settings_cents_ok">"In tune" threshold</string>
    <string name="settings_cents_warn">"Off" threshold</string>
    <string name="settings_cents_help">Deviation in cents up to which the note counts as in tune (green) and tolerable (yellow). Beyond that — red.</string>
    <string name="settings_confidence">Pitch confidence</string>
    <string name="settings_confidence_help">Minimum pitch-detector confidence for a note to count. Lower — more false notes; higher — gaps on quiet sound.</string>
    <string name="settings_spl_k">Loudness normalisation k</string>
    <string name="settings_spl_k_help">How many dB the cupola "naturally" grows per +1 dB of loudness. Subtracted so loudness is never rewarded. 0.7 per the literature.</string>
