    <!-- session -->
    <string name="need_calibration_title">Нужна калибровка</string>
    <string name="need_calibration_body">Очки считаются относительно вашего голоса на этом устройстве. Калибровка занимает 6 секунд: 2 с тишины и 4 с звука «а».</string>
